{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["packages", "apps", "evals", "scripts", "vitest.config.ts", "vitest.setup.ts"],
  "exclude": [
    "**/node_modules",
    "dist",
    "packages/trigger",
    "apps/web/app",
    "apps/web/lib",
    "apps/web/proxy.ts",
    "apps/web/next.config.mjs",
    "apps/web/next-env.d.ts",
    "apps/web/.next"
  ]
}
