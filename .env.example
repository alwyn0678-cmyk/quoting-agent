# QuoteAgent — Supabase config template (Phase 1+). Copy to .env (gitignored) and fill in.
# Account: carlyshartin@gmail.com (this project only). Northscale stays the main Supabase account.
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token used to create/manage the project from the CLI:
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Anthropic key for the live agent + eval runner (personal/Cortex key, NOT the Gmail-cloud key).
ANTHROPIC_API_KEY=

# Google Gemini API key for Gemini Embedding 2 (Q3 RAG knowledge retrieval). When unset, the draft is
# simply ungrounded (stub-safe). https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
