# QuoteAgent — Supabase config template (Phase 1+). Copy to .env (gitignored) and fill in.
# Use a Supabase project dedicated to QuoteAgent (kept separate from any other account).
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token used to create/manage the project from the CLI:
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ── LLM (any provider). With NOTHING set here QuoteAgent runs in DEMO mode: it replays recorded model
# responses for the bundled example emails (pricing, gate and guards still run live).
# Anthropic (default): both steps use anthropic/claude-opus-5-5.
ANTHROPIC_API_KEY=
# Pick any provider with "provider/model" (anthropic, openai, google, azure, bedrock, ollama,
# openrouter, openai-compatible). Per-step overrides are optional.
# QUOTEAGENT_MODEL=openai/gpt-5.1
# QUOTEAGENT_EXTRACT_MODEL=anthropic/claude-opus-5-5
# QUOTEAGENT_DRAFT_MODEL=ollama/qwen2.5:7b
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_BASE_URL=          # any OpenAI-compatible server (vLLM, LM Studio, Groq, Together…)
# OPENAI_COMPATIBLE_API_KEY=
# QUOTEAGENT_EFFORT=high               # Anthropic effort level (optional)
# QUOTEAGENT_RECORD=1                  # record live responses as demo cassettes (examples/cassettes)
# QUOTEAGENT_ANTHROPIC_FALLBACK=1      # server-side refusal fallbacks (off: a fallback model is not eval-gated)
# QUOTEAGENT_CANARY=                   # per-deployment system-prompt canary (the repo default is public)


# ── Microsoft Graph / Outlook — live mail poll (AC-G5) + real send on Approve (D-27). All optional;
# unset ⇒ the scheduled poll uses a stub and the send-outbox worker is simply not run. Setup:
# docs/setup/graph-mail-poll-setup.md (app registration: Mail.Read + Mail.Send, admin consent, an
# Exchange ApplicationAccessPolicy scoping the app to ONE mailbox).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX_USER=
GRAPH_QUOTE_FOLDER=

# Trigger.dev autonomous poll — OPTIONAL. Overrides the tenant the scheduled poll runs for; leave
# COMMENTED OUT (not empty) — the code uses `?? LINKPORT_TENANT_ID`, so an empty string breaks it.
# QUOTEAGENT_TENANT_ID=
