# QuoteAgent — Supabase config template (Phase 1+). Copy to .env (gitignored) and fill in.
# Use a Supabase project dedicated to QuoteAgent (kept separate from any other account).
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token used to create/manage the project from the CLI:
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Anthropic key for the live agent + eval runner.
ANTHROPIC_API_KEY=

# Google Gemini API key for Gemini Embedding 2 (Q3 RAG knowledge retrieval). When unset, the draft is
# simply ungrounded (stub-safe). https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Microsoft Graph / Outlook — live mail poll (AC-G5) + real send on Approve (D-27). All optional;
# unset ⇒ the scheduled poll uses a stub and the send-outbox worker is simply not run. Setup:
# docs/setup/graph-mail-poll-setup.md (app registration: Mail.Read + Mail.Send, admin consent, an
# Exchange ApplicationAccessPolicy scoping the app to ONE mailbox).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX_USER=
GRAPH_QUOTE_FOLDER=

# Trigger.dev autonomous poll — OPTIONAL. Overrides the tenant the scheduled poll runs for; leave
# COMMENTED OUT (not empty) — the code uses `?? LINKPORT_TENANT_ID`, so an empty string breaks it.
# QUOTEAGENT_TENANT_ID=
